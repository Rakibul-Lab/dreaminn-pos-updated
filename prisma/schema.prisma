generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "debian-openssl-1.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  name              String
  password          String
  role              RoleType           @default(HOTEL_STAFF)
  active            Boolean            @default(true)
  phone             String?
  avatar            String?            @db.LongText
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  activityLogs      ActivityLog[]
  bookings          Booking[]
  housekeepingTasks HousekeepingTask[]
  payments          Payment[]
  restaurantOrders  RestaurantOrder[]
  hotelDeposits     HotelDeposit[]
  hotelClearedBills CompanyLedgerBill[] @relation("HotelClearedBills")
  recordedRoomCharges RoomCharge[]      @relation("RoomChargesRecorded")
  createdPaymentCategories PaymentCategory[] @relation("PaymentCategoriesCreated")
  dayCloses         DayClose[]
  hotelBeverageSales HotelBeverageSale[]
  transportSales     TransportSale[]
  reservationEntries ReservationEntry[]

  @@map("users")
}

model RoomType {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  capacity    Int      @default(2)
  amenities   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  rooms       Room[]
  reservationEntryLines ReservationEntryLine[]

  @@map("room_types")
}

model Room {
  id                   String             @id @default(cuid())
  roomNumber           String             @unique
  floor                Int                @default(1)
  status               RoomStatus         @default(AVAILABLE)
  maintenancePurpose   String?            @map("maintenance_purpose")
  typeId               String
  totalPrice           Float              @default(0) @map("total_price")
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  bookings         Booking[]
  housekeeping     HousekeepingTask[]
  restaurantOrders RestaurantOrder[]
  hotelBeverageSales HotelBeverageSale[]
  transportSales     TransportSale[]
  reservationEntryLines ReservationEntryLine[]
  reservationEntryLineBookings ReservationEntryLineBooking[]
  type             RoomType           @relation(fields: [typeId], references: [id])

  @@index([typeId], map: "rooms_typeId_fkey")
  @@map("rooms")
}

model CompanyLedger {
  id            String               @id @default(cuid())
  name          String
  slug          String?              @unique
  isSystem      Boolean              @default(false) @map("is_system")
  contactPerson String?              @map("contact_person")
  phone         String?
  email         String?
  address       String?
  notes         String?
  active        Boolean              @default(true)
  totalBilled   Float                @default(0) @map("total_billed")
  totalPaid     Float                @default(0) @map("total_paid")
  dueAmount     Float                @default(0) @map("due_amount")
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  guests        CompanyLedgerGuest[]
  bookings      Booking[]
  bills         CompanyLedgerBill[]
  reservationEntries ReservationEntry[]

  @@map("company_ledgers")
}

model CompanyLedgerGuest {
  id                 String        @id @default(cuid())
  companyLedgerId    String        @map("company_ledger_id")
  guestName          String        @map("guest_name")
  phone              String?
  email              String?
  nationality        String?
  registrationNumber String?       @map("registration_number")
  address            String?
  idType             String?       @map("id_type")
  idNumber           String?       @map("id_number")
  designation        String?
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  companyLedger      CompanyLedger @relation(fields: [companyLedgerId], references: [id], onDelete: Cascade)
  bookings           Booking[]

  @@index([companyLedgerId], map: "company_ledger_guests_company_ledger_id_fkey")
  @@map("company_ledger_guests")
}

model CompanyLedgerBill {
  id                String                @id @default(cuid())
  companyLedgerId   String                @map("company_ledger_id")
  billType          CompanyLedgerBillType @default(BOOKING) @map("bill_type")
  settlementStage   LedgerSettlementStage @default(OPEN) @map("settlement_stage")
  bookingId         String?               @unique @map("booking_id")
  reservationEntryId String?              @unique @map("reservation_entry_id")
  restaurantOrderId String?               @unique @map("restaurant_order_id")
  invoiceId         String?               @map("invoice_id")
  guestName         String                @map("guest_name")
  roomNumber        String?               @map("room_number")
  orderNumber       String?               @map("order_number")
  orderType         String?               @map("order_type")
  totalAmount       Float                 @map("total_amount")
  paidAmount        Float                 @default(0) @map("paid_amount")
  dueAmount         Float                 @map("due_amount")
  billedAt          DateTime              @default(now()) @map("billed_at")
  hotelClearedAt    DateTime?             @map("hotel_cleared_at")
  hotelClearedBy    String?               @map("hotel_cleared_by")
  notes             String?
  companyLedger     CompanyLedger         @relation(fields: [companyLedgerId], references: [id], onDelete: Cascade)
  booking           Booking?              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  reservationEntry  ReservationEntry?     @relation(fields: [reservationEntryId], references: [id], onDelete: Cascade)
  restaurantOrder   RestaurantOrder?      @relation(fields: [restaurantOrderId], references: [id], onDelete: Cascade)
  hotelClearer      User?                 @relation("HotelClearedBills", fields: [hotelClearedBy], references: [id])

  @@index([companyLedgerId], map: "company_ledger_bills_company_ledger_id_fkey")
  @@index([settlementStage], map: "company_ledger_bills_settlement_stage_idx")
  @@map("company_ledger_bills")
}

model Customer {
  id        String    @id @default(cuid())
  name      String
  company   String?
  email     String?
  phone     String?
  address   String?
  idType       String?
  idNumber             String?
  visaExpiryDate       String? @map("visa_expiry_date")
  registrationNumber   String? @map("registration_number")
  nationality          String?
  designation          String?
  dateOfBirth  String?
  idDocPath    String?
  notes        String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]

  @@map("customers")
}

model Booking {
  id                 String            @id @default(cuid())
  confirmationNumber String?           @map("confirmation_number")
  registrationNumber String?           @map("registration_number")
  customerId       String
  roomId           String
  status               BookingStatus     @default(RESERVED)
  isInitialReservation Boolean           @default(false) @map("is_initial_reservation")
  isCorporateGuest     Boolean           @default(false) @map("is_corporate_guest")
  checkIn              DateTime
  checkOut         DateTime
  actualCheckIn    DateTime?
  actualCheckOut   DateTime?
  adults           Int               @default(1)
  children         Int               @default(0)
  totalRoomCharge  Float             @default(0)
  advancePayment   Float             @default(0)
  initialPayment   Float             @default(0)
  dueAmount        Float             @default(0)
  vatApplied       Boolean           @default(true) @map("vat_applied")
  vatPercent       Float             @default(15) @map("vat_percent")
  serviceChargePercent Float?        @default(10) @map("service_charge_percent")
  company          String?
  companyLedgerId      String?           @map("company_ledger_id")
  companyLedgerGuestId String?           @map("company_ledger_guest_id")
  withMeal         Boolean           @default(false) @map("with_meal")
  discountEnabled  Boolean           @default(false) @map("discount_enabled")
  discountType     String?           @map("discount_type")
  discountValue    Float             @default(0) @map("discount_value")
  billTransferredToBookingId String? @map("bill_transferred_to_booking_id")
  sourceReservationEntryId   String? @map("source_reservation_entry_id")
  nidPhysicallyReceived Boolean           @default(true) @map("nid_physically_received")
  notes            String?
  createdBy        String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  creator          User              @relation(fields: [createdBy], references: [id])
  customer         Customer          @relation(fields: [customerId], references: [id])
  room             Room              @relation(fields: [roomId], references: [id])
  companyLedger        CompanyLedger?      @relation(fields: [companyLedgerId], references: [id], onDelete: SetNull)
  companyLedgerGuest   CompanyLedgerGuest? @relation(fields: [companyLedgerGuestId], references: [id], onDelete: SetNull)
  companyLedgerBill    CompanyLedgerBill?
  sourceReservationEntry ReservationEntry? @relation("EntrySourceBookings", fields: [sourceReservationEntryId], references: [id], onDelete: SetNull)
  reservationEntryLineBooking ReservationEntryLineBooking?
  invoices         Invoice[]
  payments         Payment[]
  restaurantOrders RestaurantOrder[]
  hotelBeverageSales HotelBeverageSale[]
  transportSales     TransportSale[]
  charges          RoomCharge[]
  idDocuments      BookingIdDocument[]
  companions       BookingCompanion[]

  @@index([createdBy], map: "bookings_createdBy_fkey")
  @@index([customerId], map: "bookings_customerId_fkey")
  @@index([roomId], map: "bookings_roomId_fkey")
  @@index([registrationNumber], map: "bookings_registration_number_idx")
  @@index([sourceReservationEntryId], map: "bookings_source_reservation_entry_id_fkey")
  @@map("bookings")
}

model ReservationEntry {
  id                String                 @id @default(cuid())
  checkIn           DateTime               @map("check_in")
  checkOut          DateTime               @map("check_out")
  guestName         String?                @map("guest_name")
  guestPhone        String?                @map("guest_phone")
  guestEmail        String?                @map("guest_email")
  guestAddress      String?                @map("guest_address")
  guestNationality  String?                @map("guest_nationality")
  guestIdType       String?                @map("guest_id_type")
  guestIdNumber     String?                @map("guest_id_number")
  nidPhysicallyReceived Boolean            @default(false) @map("nid_physically_received")
  company           String?
  companyLedgerId   String?                @map("company_ledger_id")
  totalAmount       Float                  @default(0) @map("total_amount")
  advancePayment    Float                  @default(0) @map("advance_payment")
  dueAmount         Float                  @default(0) @map("due_amount")
  discountEnabled   Boolean                @default(false) @map("discount_enabled")
  discountType      String?                @map("discount_type")
  discountValue     Float                  @default(0) @map("discount_value")
  notes               String?
  registrationNumber  String?                @unique @map("registration_number")
  confirmationNumber  String?                @unique @map("confirmation_number")
  status              ReservationEntryStatus @default(ACTIVE)
  fulfilledAt         DateTime?              @map("fulfilled_at")
  createdBy           String                 @map("created_by")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")
  creator           User                   @relation(fields: [createdBy], references: [id])
  companyLedger     CompanyLedger?         @relation(fields: [companyLedgerId], references: [id], onDelete: SetNull)
  lines             ReservationEntryLine[]
  payments          Payment[]
  companyLedgerBill CompanyLedgerBill?
  sourceBookings    Booking[]              @relation("EntrySourceBookings")

  @@index([createdBy], map: "reservation_entries_created_by_fkey")
  @@index([status], map: "reservation_entries_status_idx")
  @@index([companyLedgerId], map: "reservation_entries_company_ledger_id_fkey")
  @@map("reservation_entries")
}

model ReservationEntryLine {
  id                 String           @id @default(cuid())
  reservationEntryId String           @map("reservation_entry_id")
  roomTypeId         String           @map("room_type_id")
  roomId             String?          @map("room_id")
  quantity           Int              @default(1)
  reservationEntry   ReservationEntry @relation(fields: [reservationEntryId], references: [id], onDelete: Cascade)
  roomType           RoomType         @relation(fields: [roomTypeId], references: [id])
  room               Room?            @relation(fields: [roomId], references: [id], onDelete: SetNull)
  lineBookings       ReservationEntryLineBooking[]

  @@index([reservationEntryId], map: "reservation_entry_lines_reservation_entry_id_fkey")
  @@index([roomTypeId], map: "reservation_entry_lines_room_type_id_fkey")
  @@index([roomId], map: "reservation_entry_lines_room_id_fkey")
  @@map("reservation_entry_lines")
}

model ReservationEntryLineBooking {
  id                     String               @id @default(cuid())
  reservationEntryLineId String               @map("reservation_entry_line_id")
  bookingId              String               @unique @map("booking_id")
  roomId                 String               @map("room_id")
  createdAt              DateTime             @default(now()) @map("created_at")
  line                   ReservationEntryLine @relation(fields: [reservationEntryLineId], references: [id], onDelete: Cascade)
  booking                Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  room                   Room                 @relation(fields: [roomId], references: [id])

  @@index([reservationEntryLineId], map: "reservation_entry_line_bookings_line_id_fkey")
  @@index([roomId], map: "reservation_entry_line_bookings_room_id_fkey")
  @@map("reservation_entry_line_bookings")
}

model BookingIdDocument {
  id        String   @id @default(cuid())
  bookingId String   @map("booking_id")
  filePath  String   @map("file_path")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId], map: "booking_id_documents_booking_id_fkey")
  @@map("booking_id_documents")
}

model BookingCompanion {
  id                 String         @id @default(cuid())
  bookingId          String         @map("booking_id")
  sortOrder          Int            @default(0) @map("sort_order")
  companionType      CompanionType  @default(ADULT) @map("companion_type")
  name               String
  company            String?
  designation        String?
  phone              String?
  nationality        String?
  idType             String?        @map("id_type")
  idNumber           String?        @map("id_number")
  visaExpiryDate     String?        @map("visa_expiry_date")
  registrationNumber String?        @map("registration_number")
  email              String?
  address            String?
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  booking            Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId], map: "booking_companions_booking_id_fkey")
  @@map("booking_companions")
}

model RoomCharge {
  id                  String             @id @default(cuid())
  bookingId           String
  chargeType          ChargeType         @default(ROOM_RATE)
  description         String
  notes               String?
  amount              Float
  quantity            Int                @default(1)
  chargeDate          DateTime           @default(now())
  hotelBeverageSaleId String?            @map("hotel_beverage_sale_id")
  transportSaleId     String?            @map("transport_sale_id")
  /** Set only for charges posted from Payments → Send to Room. */
  recordedBy          String?            @map("recorded_by")
  createdAt           DateTime           @default(now())
  booking             Booking            @relation(fields: [bookingId], references: [id])
  hotelBeverageSale   HotelBeverageSale? @relation(fields: [hotelBeverageSaleId], references: [id], onDelete: SetNull)
  transportSale       TransportSale?     @relation(fields: [transportSaleId], references: [id], onDelete: SetNull)
  recorder            User?              @relation("RoomChargesRecorded", fields: [recordedBy], references: [id])

  @@index([bookingId], map: "room_charges_bookingId_fkey")
  @@index([hotelBeverageSaleId], map: "room_charges_hotel_beverage_sale_id_fkey")
  @@index([transportSaleId], map: "room_charges_transport_sale_id_fkey")
  @@index([recordedBy], map: "room_charges_recorded_by_fkey")
  @@map("room_charges")
}

model MenuCategory {
  id          String     @id @default(cuid())
  name        String
  description String?
  active      Boolean    @default(true)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  items       MenuItem[]

  @@map("menu_categories")
}

model MenuItem {
  id              String       @id @default(cuid())
  categoryId      String
  name            String
  description     String?
  price           Float
  image           String?      @db.LongText
  available       Boolean      @default(true)
  isVeg           Boolean      @default(true)
  preparationTime Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  category        MenuCategory @relation(fields: [categoryId], references: [id])
  orderItems      OrderItem[]
  beverageSaleItems HotelBeverageSaleItem[]

  @@index([categoryId], map: "menu_items_categoryId_fkey")
  @@map("menu_items")
}

model RestaurantTable {
  id          String            @id @default(cuid())
  tableNumber String
  capacity    Int               @default(4)
  status      String            @default("available")
  location    String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  orders      RestaurantOrder[]

  @@map("restaurant_tables")
}

model RestaurantWaiter {
  id        String            @id @default(cuid())
  name      String
  phone     String?
  active    Boolean           @default(true)
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  orders    RestaurantOrder[]

  @@map("restaurant_waiters")
}

model RestaurantOrder {
  id            String           @id @default(cuid())
  orderNumber   String           @unique
  orderType     OrderType        @default(DINE_IN)
  status        OrderStatus      @default(PENDING)
  roomId        String?
  tableId       String?
  bookingId     String?
  customerName  String?
  customerPhone String?
  subtotal      Float            @default(0)
  discount      Float            @default(0)
  vatAmount     Float            @default(0)
  vatPercent    Float            @default(0)
  totalAmount   Float            @default(0)
  billingDisposition RestaurantBillingDisposition @default(PENDING) @map("billing_disposition")
  notes         String?
  waiterId      String?          @map("waiter_id")
  createdBy     String
  businessDate  String?          @map("business_date")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  items         OrderItem[]
  payments      Payment[]
  booking       Booking?         @relation(fields: [bookingId], references: [id])
  creator       User             @relation(fields: [createdBy], references: [id])
  waiter        RestaurantWaiter? @relation(fields: [waiterId], references: [id])
  room              Room?              @relation(fields: [roomId], references: [id])
  table             RestaurantTable?   @relation(fields: [tableId], references: [id])
  companyLedgerBill CompanyLedgerBill?

  @@index([bookingId], map: "restaurant_orders_bookingId_fkey")
  @@index([createdBy], map: "restaurant_orders_createdBy_fkey")
  @@index([waiterId], map: "restaurant_orders_waiter_id_fkey")
  @@index([roomId], map: "restaurant_orders_roomId_fkey")
  @@index([tableId], map: "restaurant_orders_tableId_fkey")
  @@map("restaurant_orders")
}

model OrderItem {
  id         String          @id @default(cuid())
  orderId    String
  menuItemId String
  quantity   Int             @default(1)
  price      Float
  notes      String?
  kotStatus  String          @default("pending")
  menuItem   MenuItem        @relation(fields: [menuItemId], references: [id])
  order      RestaurantOrder @relation(fields: [orderId], references: [id])

  @@index([menuItemId], map: "order_items_menuItemId_fkey")
  @@index([orderId], map: "order_items_orderId_fkey")
  @@map("order_items")
}

model Payment {
  id               String                      @id @default(cuid())
  amount           Float
  method           PaymentMethod               @default(CASH)
  paymentType      PaymentType
  bookingId        String?
  reservationEntryId String?               @map("reservation_entry_id")
  orderId          String?
  invoiceId        String?
  reference        String?
  accountLastFour  String?                     @map("account_last_four")
  notes            String?
  /** Label of the user-defined payment type; null for the built-in types. */
  categoryLabel    String?                     @map("category_label")
  settlementSource RestaurantSettlementSource? @map("settlement_source")
  businessDate     String?                     @map("business_date")
  receivedBy       String
  createdAt        DateTime                    @default(now())
  booking     Booking?         @relation(fields: [bookingId], references: [id])
  reservationEntry ReservationEntry? @relation(fields: [reservationEntryId], references: [id])
  invoice     Invoice?         @relation(fields: [invoiceId], references: [id])
  order       RestaurantOrder? @relation(fields: [orderId], references: [id])
  receiver    User             @relation(fields: [receivedBy], references: [id])

  @@index([bookingId], map: "payments_bookingId_fkey")
  @@index([reservationEntryId], map: "payments_reservation_entry_id_fkey")
  @@index([invoiceId], map: "payments_invoiceId_fkey")
  @@index([orderId], map: "payments_orderId_fkey")
  @@index([receivedBy], map: "payments_receivedBy_fkey")
  @@map("payments")
}

model HotelDeposit {
  id              String        @id @default(cuid())
  amount          Float
  method          PaymentMethod @default(CASH)
  bankName        String?       @map("bank_name")
  accountLastFour String?       @map("account_last_four")
  reference       String?
  notes           String?
  businessDate    String?       @map("business_date")
  depositedBy     String        @map("deposited_by")
  depositedAt     DateTime      @default(now()) @map("deposited_at")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  depositor       User          @relation(fields: [depositedBy], references: [id])

  @@index([depositedBy], map: "hotel_deposits_deposited_by_fkey")
  @@index([depositedAt], map: "hotel_deposits_deposited_at_idx")
  @@map("hotel_deposits")
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  bookingId     String
  roomCharges   Float         @default(0)
  foodCharges   Float         @default(0)
  extraCharges  Float         @default(0)
  subtotal      Float         @default(0)
  discount      Float         @default(0)
  vatAmount     Float         @default(0)
  totalAmount   Float         @default(0)
  paidAmount    Float         @default(0)
  dueAmount     Float         @default(0)
  status        InvoiceStatus @default(DRAFT)
  businessDate  String?       @map("business_date")
  issuedAt      DateTime?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  items         InvoiceItem[]
  booking       Booking       @relation(fields: [bookingId], references: [id])
  payments      Payment[]

  @@index([bookingId], map: "invoices_bookingId_fkey")
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  itemType    String
  referenceId String?
  description String
  quantity    Int     @default(1)
  unitPrice   Float
  total       Float
  invoice     Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId], map: "invoice_items_invoiceId_fkey")
  @@map("invoice_items")
}

model CleaningStaff {
  id        String             @id @default(cuid())
  staffCode String             @unique @map("staff_code")
  name      String
  phone     String?
  active    Boolean            @default(true)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  tasks     HousekeepingTask[]

  @@map("cleaning_staff")
}

model HousekeepingTask {
  id              String             @id @default(cuid())
  roomId          String
  taskType        String
  status          HousekeepingStatus @default(PENDING)
  assignedTo      String?
  cleaningStaffId String?            @map("cleaning_staff_id")
  notes           String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  assigned        User?              @relation(fields: [assignedTo], references: [id])
  cleaningStaff   CleaningStaff?     @relation(fields: [cleaningStaffId], references: [id])
  room            Room               @relation(fields: [roomId], references: [id])

  @@index([assignedTo], map: "housekeeping_tasks_assignedTo_fkey")
  @@index([cleaningStaffId], map: "housekeeping_tasks_cleaning_staff_id_fkey")
  @@index([roomId], map: "housekeeping_tasks_roomId_fkey")
  @@map("housekeeping_tasks")
}

model InventoryCategory {
  id          String          @id @default(cuid())
  name        String          @unique
  description String?
  active      Boolean         @default(true)
  sortOrder   Int             @default(0) @map("sort_order")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  items       InventoryItem[]

  @@map("inventory_categories")
}

model InventoryItem {
  id           String                 @id @default(cuid())
  name         String
  category     String?
  categoryId   String?                @map("category_id")
  unit         String
  quantity     Float                  @default(0)
  minQuantity  Float                  @default(0)
  costPerUnit  Float?
  supplier     String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  inventoryCategory InventoryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transactions InventoryTransaction[]

  @@index([categoryId], map: "inventory_items_category_id_fkey")
  @@map("inventory_items")
}

model InventoryTransaction {
  id        String        @id @default(cuid())
  itemId    String
  type      String
  quantity  Float
  notes     String?
  createdBy String
  createdAt DateTime      @default(now())
  item      InventoryItem @relation(fields: [itemId], references: [id])

  @@index([itemId], map: "inventory_transactions_itemId_fkey")
  @@map("inventory_transactions")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  title     String
  message   String
  type      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  module    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId], map: "activity_logs_userId_fkey")
  @@map("activity_logs")
}

model Setting {
  id    String  @id @default(cuid())
  key   String  @unique
  value String
  group String?

  @@map("settings")
}

/** User-defined payment types offered next to the built-in ones in Record New Payment. */
model PaymentCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  creator   User?    @relation("PaymentCategoriesCreated", fields: [createdBy], references: [id])

  @@index([createdBy], map: "payment_categories_created_by_fkey")
  @@map("payment_categories")
}

model DayClose {
  id           String   @id @default(cuid())
  businessDate String   @map("business_date")
  openedAt     DateTime @map("opened_at")
  closedAt     DateTime @map("closed_at")
  closedBy     String   @map("closed_by")
  snapshot     Json
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  closer       User     @relation(fields: [closedBy], references: [id])

  @@unique([businessDate])
  @@index([closedBy], map: "day_closes_closed_by_fkey")
  @@index([closedAt], map: "day_closes_closed_at_idx")
  @@map("day_closes")
}

enum HotelBeverageSaleType {
  WALK_IN
  ROOM
}

model HotelBeverageSale {
  id            String                  @id @default(cuid())
  saleNumber    String                  @unique @map("sale_number")
  saleType      HotelBeverageSaleType     @map("sale_type")
  bookingId     String?                 @map("booking_id")
  roomId        String?                 @map("room_id")
  customerName  String?                 @map("customer_name")
  customerPhone String?                 @map("customer_phone")
  subtotal      Float                   @default(0)
  totalAmount   Float                   @default(0) @map("total_amount")
  paymentMethod PaymentMethod?          @map("payment_method")
  notes         String?
  createdBy     String?                 @map("created_by")
  createdAt     DateTime                @default(now()) @map("created_at")
  booking       Booking?                @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  room          Room?                   @relation(fields: [roomId], references: [id], onDelete: SetNull)
  creator       User?                   @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  items         HotelBeverageSaleItem[]
  roomCharges   RoomCharge[]

  @@index([bookingId], map: "hotel_beverage_sales_booking_id_fkey")
  @@index([roomId], map: "hotel_beverage_sales_room_id_fkey")
  @@index([createdBy], map: "hotel_beverage_sales_created_by_fkey")
  @@map("hotel_beverage_sales")
}

model HotelBeverageSaleItem {
  id         String            @id @default(cuid())
  saleId     String            @map("sale_id")
  menuItemId String?           @map("menu_item_id")
  itemName   String            @map("item_name")
  quantity   Int               @default(1)
  unitPrice  Float             @map("unit_price")
  lineTotal  Float             @map("line_total")
  sale       HotelBeverageSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  menuItem   MenuItem?         @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([saleId], map: "hotel_beverage_sale_items_sale_id_fkey")
  @@index([menuItemId], map: "hotel_beverage_sale_items_menu_item_id_fkey")
  @@map("hotel_beverage_sale_items")
}

enum TransportSaleType {
  WALK_IN
  ROOM
}

enum TransportInvoiceStatus {
  ISSUED
  PAID
  CANCELLED
}

model TransportService {
  id           String              @id @default(cuid())
  name         String
  description  String?
  defaultPrice Float               @default(0) @map("default_price")
  isActive     Boolean             @default(true) @map("is_active")
  sortOrder    Int                 @default(0) @map("sort_order")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  saleItems    TransportSaleItem[]

  @@map("transport_services")
}

model TransportSale {
  id            String            @id @default(cuid())
  saleNumber    String            @unique @map("sale_number")
  saleType      TransportSaleType @map("sale_type")
  bookingId     String?           @map("booking_id")
  roomId        String?           @map("room_id")
  roomNumber    String?           @map("room_number")
  customerName  String            @map("customer_name")
  customerPhone String?           @map("customer_phone")
  routeFrom     String?           @map("route_from")
  routeTo       String?           @map("route_to")
  vehicleType   String?           @map("vehicle_type")
  tripDate      DateTime?         @map("trip_date")
  subtotal      Float             @default(0)
  vatAmount     Float             @default(0) @map("vat_amount")
  totalAmount   Float             @default(0) @map("total_amount")
  paymentMethod PaymentMethod?    @map("payment_method")
  notes         String?
  businessDate  String?           @map("business_date")
  createdBy     String?           @map("created_by")
  createdAt     DateTime          @default(now()) @map("created_at")
  booking       Booking?          @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  room          Room?             @relation(fields: [roomId], references: [id], onDelete: SetNull)
  creator       User?             @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  items         TransportSaleItem[]
  invoice       TransportInvoice?
  roomCharges   RoomCharge[]

  @@index([bookingId], map: "transport_sales_booking_id_fkey")
  @@index([roomId], map: "transport_sales_room_id_fkey")
  @@index([createdBy], map: "transport_sales_created_by_fkey")
  @@index([businessDate], map: "transport_sales_business_date_idx")
  @@map("transport_sales")
}

model TransportSaleItem {
  id                 String            @id @default(cuid())
  saleId             String            @map("sale_id")
  transportServiceId String?           @map("transport_service_id")
  serviceName        String            @map("service_name")
  description        String?
  quantity           Int               @default(1)
  unitPrice          Float             @map("unit_price")
  lineTotal          Float             @map("line_total")
  sale               TransportSale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  transportService   TransportService? @relation(fields: [transportServiceId], references: [id], onDelete: SetNull)

  @@index([saleId], map: "transport_sale_items_sale_id_fkey")
  @@index([transportServiceId], map: "transport_sale_items_transport_service_id_fkey")
  @@map("transport_sale_items")
}

model TransportInvoice {
  id            String                 @id @default(cuid())
  invoiceNumber String                 @unique @map("invoice_number")
  saleId        String                 @unique @map("sale_id")
  subtotal      Float                  @default(0)
  vatAmount     Float                  @default(0) @map("vat_amount")
  discount      Float                  @default(0)
  totalAmount   Float                  @default(0) @map("total_amount")
  paidAmount    Float                  @default(0) @map("paid_amount")
  dueAmount     Float                  @default(0) @map("due_amount")
  status        TransportInvoiceStatus @default(ISSUED)
  businessDate  String?                @map("business_date")
  issuedAt      DateTime               @default(now()) @map("issued_at")
  paidAt        DateTime?              @map("paid_at")
  createdAt     DateTime               @default(now()) @map("created_at")
  sale          TransportSale          @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([businessDate], map: "transport_invoices_business_date_idx")
  @@map("transport_invoices")
}

